# Names only. Never commit values. On a Sprite, Connectors hold the provider tokens.
PORT=8080
# Pushover via Sprites Connector (gateway URL from the connector detail page)
PUSHOVER_GATEWAY_URL=
PUSHOVER_USER_KEY=
# Local-only alternative (direct to api.pushover.net); leave empty on the Sprite
PUSHOVER_APP_TOKEN=
# GitHub archive via Sprites Connector
GITHUB_GATEWAY_URL=
GITHUB_REPO=
# Required: /run refuses every call without it (send it as the X-Run-Key header)
RUN_KEY=
# Optional second judge for /ask: TypeSafeAI Connector (Jev). Gateway URL from the
# connector detail page, without a trailing /v1. JEV=0 turns it off.
TYPESAFE_GATEWAY_URL=
JEV_THRESHOLD=0.8
# Optional
DRY_RUN=
